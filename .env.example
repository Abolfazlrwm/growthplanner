# Local development. Copy to .env and choose a real random secret. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Omit DATABASE_URL for local SQLite. Managed hosting injects MySQL automatically.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
# Production: DEBUG=False, exact ALLOWED_HOSTS, HTTPS CSRF origin, secure SECRET_KEY.
# PUBLIC_ORIGIN=https://your-real-domain.example
# AI: managed hosting injects MANUS_API_URL and MANUS_API_KEY.
# Outside managed hosting, set a server-side OpenAI-compatible API and supported model.
# MANUS_API_URL=https://api.openai.com
# MANUS_API_KEY=your-private-provider-key
# AI_MODEL=choose-a-model-available-from-your-provider
# SMTP is required for real password recovery. Console backend is development only.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-private-smtp-password
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=GrowthPlanner <no-reply@your-domain.example>
# For a different trusted embedding shell, explicitly list HTTPS origins; never use *.
# FRAME_ANCESTORS='self',https://manus.im,https://www.manus.im
